#!/bin/bash -l
#PBS -N polyattn-gonogo
# NOTE: no #PBS -A here on purpose. Pass it at submit time:
#         qsub -A <your_project> polaris/<script>.pbs
#       A placeholder or invalid project is accepted by qsub and the
#       job then sits in H (held) forever with no log written.
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=00:30:00
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o logs/

# SMOKE TEST + THE ONE MEASUREMENT THAT DECIDES THE PROJECT.
# Submit this before job_experiments.pbs. If exp0 says the 7.79x predicted
# element reduction does not become a wall-clock win, the broad sweep is not
# worth queueing.

set -euo pipefail
cd "${PBS_O_WORKDIR:-$PWD}"
mkdir -p logs results

# The module name is DISCOVERED by setup.sh, not assumed here -- the site's
# `conda` modulefile has been seen to fail dependency resolution while
# `frameworks` works. env.generated.sh records whichever one actually loaded.
if [ -f polaris/env.generated.sh ]; then
  . polaris/env.generated.sh
else
  echo "FATAL: polaris/env.generated.sh missing -- run polaris/setup.sh on a LOGIN node first." >&2
  exit 1
fi

module use /soft/modulefiles
module --ignore_cache load "${POLYATTN_MODULE:-conda}" || {
  echo "FATAL: module load ${POLYATTN_MODULE:-conda} failed on the compute node" >&2
  echo "       (it worked on the login node -- module stacks can differ)" >&2
  exit 1
}

# conda's activate scripts reference unset variables; `set -u` turns that into
# an immediate non-zero exit, which PBS reports only as a job that went straight
# to E with an empty log. Disable -u across activation, restore after.
# setup.sh records which conda module and venv actually worked on the login
# node. Hard-coding either here is how a job fails in the queue the same way
# setup.sh already failed interactively.
if [ ! -f polaris/env.generated.sh ]; then
  echo "FATAL: polaris/env.generated.sh missing -- run polaris/setup.sh on a LOGIN node first." >&2
  exit 2
fi
source polaris/env.generated.sh

# The module load is BEST EFFORT, deliberately. The site's default conda
# modulefile can require dependency versions the system does not have, and that
# failure is not ours to fix -- but it also does not have to stop the job. What
# actually matters is that the venv's interpreter runs and torch sees the GPU,
# so that is what we gate on. `module load` being fatal here was wrong: it made
# a cosmetic failure look like a blocking one.
set +u
if ! module load "$POLYATTN_MODULE" 2>/tmp/.mod.$$; then
  echo "WARN: module load $POLYATTN_MODULE failed on the compute node:" >&2
  sed 's/^/      /' /tmp/.mod.$$ | tail -4 >&2
  echo "      continuing -- the venv is what matters. Gating on torch instead." >&2
fi
rm -f /tmp/.mod.$$
conda activate base 2>/dev/null || true

if [ ! -f "$POLYATTN_VENV/bin/activate" ]; then
  echo "FATAL: venv $POLYATTN_VENV missing -- re-run polaris/setup.sh." >&2
  exit 2
fi
source "$POLYATTN_VENV/bin/activate"
set -u

# THE REAL GATE. Nothing downstream means anything without these three.
python - <<'PYGATE' || { echo "FATAL: environment unusable, see above." >&2; exit 3; }
import sys
try:
    import torch
except Exception as e:
    print(f"FATAL: import torch failed: {type(e).__name__}: {e}")
    if "libmpi" in str(e) or "cray" in str(e).lower():
        print("       Cray MPI, not CUDA. base's torch is tied to a retired PrgEnv.")
        print("       Re-run setup.sh on a login node; it will shadow it with a wheel.")
    sys.exit(1)
if not torch.cuda.is_available():
    print(f"FATAL: torch {torch.__version__} imports but sees no GPU "
          f"(torch.version.cuda={torch.version.cuda})")
    sys.exit(1)
print(f"gate OK: torch {torch.__version__}  cuda {torch.version.cuda}  "
      f"{torch.cuda.get_device_name(0)}")
PYGATE

# Documented Polaris known issue: software that creates socket files under
# TMPDIR hits "AF_UNIX path too long", and ALCF names pytorch specifically.
# The documented fix, verbatim from the known-issues page.
export TMPDIR=/tmp

export CUDA_VISIBLE_DEVICES=0
export TRITON_CACHE_DIR="$PWD/.triton-cache-$PBS_JOBID"
export TORCHINDUCTOR_CACHE_DIR="$PWD/.inductor-cache-$PBS_JOBID"

STAMP="$(date +%Y%m%d-%H%M%S)-${PBS_JOBID%%.*}"
OUT="results/gonogo-$STAMP.txt"
{
  echo "host $(hostname)   $(date -Is)"
  nvidia-smi --query-gpu=name,memory.total,compute_cap --format=csv || true
  echo; echo "############ env ############"
  python gpu/env_check.py
  echo; echo "############ correctness ####"
  python gpu/test_correctness.py
  echo; echo "############ GO/NO-GO #######"
  python gpu/exp0_gonogo.py
} 2>&1 | tee "$OUT"
echo "wrote $OUT"
