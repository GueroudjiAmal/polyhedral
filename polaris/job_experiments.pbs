#!/bin/bash -l
#PBS -N polyattn-exp
# NOTE: no #PBS -A here on purpose. Pass it at submit time:
#         qsub -A <your_project> polaris/<script>.pbs
#       A placeholder or invalid project is accepted by qsub and the
#       job then sits in H (held) forever with no log written.
#PBS -q preemptable
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o logs/

# THE FOUR EXPERIMENTS. Only run this after job_smoke.pbs comes back clean.
# Queue note: 'preemptable' usually starts sooner and can be killed; every
# experiment writes its own file, so a preemption costs you the tail, not the run.
# Use -q prod for a guaranteed slot.

set -euo pipefail
cd "${PBS_O_WORKDIR:-$PWD}"
mkdir -p logs results

# The module name is DISCOVERED by setup.sh, not assumed here -- the site's
# `conda` modulefile has been seen to fail dependency resolution while
# `frameworks` works. env.generated.sh records whichever one actually loaded.
if [ -f polaris/env.generated.sh ]; then
  . polaris/env.generated.sh
else
  echo "FATAL: polaris/env.generated.sh missing -- run polaris/setup.sh on a LOGIN node first." >&2
  exit 1
fi

module use /soft/modulefiles
module --ignore_cache load "${POLYATTN_MODULE:-conda}" || {
  echo "FATAL: module load ${POLYATTN_MODULE:-conda} failed on the compute node" >&2
  echo "       (it worked on the login node -- module stacks can differ)" >&2
  exit 1
}

# conda's activate scripts reference unset variables; `set -u` turns that into
# an immediate non-zero exit, which PBS reports only as a job that went straight
# to E with an empty log. Disable -u across activation, restore after.
set +u
conda activate base
if [ ! -f .venv-polaris/bin/activate ]; then
  echo "FATAL: .venv-polaris missing -- run polaris/setup.sh on a LOGIN node first." >&2
  exit 2
fi
source .venv-polaris/bin/activate
set -u

# Documented Polaris known issue: software that creates socket files under
# TMPDIR hits "AF_UNIX path too long", and ALCF names pytorch specifically.
# The documented fix, verbatim from the known-issues page.
export TMPDIR=/tmp

export CUDA_VISIBLE_DEVICES=0
export TRITON_CACHE_DIR="$PWD/.triton-cache-$PBS_JOBID"
export TORCHINDUCTOR_CACHE_DIR="$PWD/.inductor-cache-$PBS_JOBID"

STAMP="$(date +%Y%m%d-%H%M%S)-${PBS_JOBID%%.*}"
echo "host $(hostname)  $(date -Is)" | tee "results/exp-$STAMP.meta"
nvidia-smi --query-gpu=name,memory.total,compute_cap --format=csv \
  | tee -a "results/exp-$STAMP.meta"

# Re-gate cheaply: a preempted requeue could land on a different node type.
python gpu/env_check.py > "results/exp-$STAMP-env.txt" 2>&1

for e in exp1_tile_shape exp2_class_a exp3_selection exp4_flex_baseline; do
  echo "===== $e ====="
  # keep going if one experiment fails; the others are independent
  python "gpu/$e.py" 2>&1 | tee "results/exp-$STAMP-$e.txt" || \
    echo "  $e FAILED -- see results/exp-$STAMP-$e.txt"
done
echo "all outputs under results/, stamp $STAMP"
