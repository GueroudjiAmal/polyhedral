.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
polaris/env.generated.sh

# Polaris: created on the cluster, must never dirty the tree or a pull is blocked
.venv-polaris/
.triton-cache-*/
.inductor-cache-*/

# PBS stdout/stderr land here (-o logs/); keep the directory, ignore the output
logs/*
!logs/.gitkeep

# job outputs. results/{reindex,results,predictions-*} stay TRACKED on purpose.
results/gonogo-*
results/smoke-*
results/exp-*
results/*/
!results/*/.gitkeep
.triton-cache-*
.inductor-cache-*
